# Example only. Export these variables before launching; not loaded automatically.
# Leave empty for offline fallback. Never commit a real key.
GEMINI_API_KEY=
# Also accepted as unset: your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ENABLE_WHISPER=0
WHISPER_MODEL=base
MAX_UPLOAD_MB=50
COOKIE_SECURE=0
